# Copy to .env and edit:  cp .env.example .env
# The nodes are configured in the inventory.yaml, not here.
# The Talos and Kubernetes versions are configured in the versions.env, not here.

# ---- Cluster topology  (VIP + sizing, step 03) ----
CLUSTER_NAME="my-cluster"               # talosctl gen config cluster name
CLUSTER_VIP="192.168.100.1"             # control-plane VIP (unused IP, outside your DHCP pool, but inside your subnet)
EPHEMERAL_SIZE="64GiB"                  # EPHEMERAL cap; the whole rest of the NVMe becomes the 'storage' volume
PRE_DRAIN_HEALTH_HOOK=""                # path to shell script to run before draining each node, to gate the reboot (e.g. check replicated store health). Empty = check disabled
PRE_DRAIN_EVACUATE_HOOK=""              # path to shell script to run once per node after that gate, to move roles off it first (e.g. switch a database primary elsewhere). Empty = nothing moves
FORCE_DELETE_SKIP=""                    # (label selector) pods 03e's force-delete leaves alone when a drain times out, e.g. "cnpg.io/podRole notin (instance)". Empty = it force-kills every pod on the node
REBALANCE_SKIP_NAMESPACES=""            # space-separated list of namespaces to skip when rebalancing pods across nodes (e.g. your CSI driver's namespace, ingress data plane). Empty = rebalance all namespaces
REBALANCE_PVC_NAMESPACES=""             # space-separated list of namespaces whose PVC-mounting Deployments 03g restarts anyway, for volumes that can follow the pod. Empty = a PVC always means skip
DISABLE_FLANNEL_AND_KUBE_PROXY="false"  # true = install your own CNI later; false = use Talos' built-in Flannel. Changing after bootstrap has no effect.
GHCR_USER="your-github-username"        # GitHub username the pull token below belongs to (also your GHCR namespace)
GITHUB_GHCR_PULL_TOKEN_SECRET=""        # classic PAT, read:packages, 03c bakes it into every node so kubelet can pull PRIVATE ghcr.io images (empty = kubelet can only pull public images)
