# Personal config + secrets TEMPLATE. Copy to .env and edit:  cp .env.example .env
# Plain KEY=value scalars only, no logic, arrays or command substitution. Versions live in the committed
# versions.env, not here.
# The IPs below are FAKE placeholders. Every SECRET is empty on purpose: leave one empty to skip the feature
# it enables. Everything that runs ON the cluster is configured in the platform repo's own .env, not here.

# ---- CONFIG: non-secret, per-deployment values ----

# ---- Cluster topology  (VIP + sizing, step 03) ----
# The nodes themselves are NOT here: per-node role, hardware type and image live in inventory.yaml, because a
# flat string cannot carry them.  cp inventory.example.yaml inventory.yaml
CLUSTER_NAME="my-cluster"              # talosctl gen config cluster name
CLUSTER_VIP="192.168.100.1"            # control-plane VIP (unused IP, outside your DHCP pool, but inside your subnet)
EPHEMERAL_SIZE="64GiB"                 # EPHEMERAL cap; the whole rest of the NVMe becomes the 'longhorn' volume

# ---- GHCR registry  (step 03c node pull auth) ----
GHCR_USER="your-github-username"       # GitHub username the pull token belongs to (also your GHCR namespace)

# ---- SECRETS: never commit or share. Each empty value skips that feature. ----

GITHUB_GHCR_PULL_TOKEN_SECRET=""       # classic PAT, read:packages, 03c bakes it into every node so kubelet pulls PRIVATE ghcr.io images (empty = public only; the Talos image itself is public)
