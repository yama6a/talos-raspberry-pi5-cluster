# Copy to .env and edit:  cp .env.example .env
# Nodes live in inventory.yaml, versions in versions.env.

# ---- Cluster topology  (VIP + sizing, step 03) ----
CLUSTER_NAME="my-cluster"               # REQUIRED: (string) the talosctl gen config cluster name
CLUSTER_VIP="192.168.100.1"             # REQUIRED: (IP) control-plane VIP. Unused, inside your subnet, outside the DHCP pool
EPHEMERAL_SIZE="64GiB"                  # REQUIRED: (size) EPHEMERAL cap. The rest of the disk becomes the `storage` volume. Fixed per node at first config
PRE_DRAIN_HEALTH_HOOK=""                # OPTIONAL: (path) executable 03e and remove-node run before draining each node, exit 0 when replicated stores are in sync. Empty: no check
PRE_DRAIN_EVACUATE_HOOK=""              # OPTIONAL: (path) executable 03e and remove-node run once per node after that check, e.g. to move a database primary off it. Empty: nothing moves
PRE_REMOVE_STORAGE_HOOK=""              # OPTIONAL: (path) executable remove-node runs once before the drain, exit 0 when the node holds no storage data. Empty: the reset wipes what is there
POST_REMOVE_STORAGE_HOOK=""             # OPTIONAL: (path) executable remove-node runs after it deletes the Kubernetes node, to drop the storage layer's record of it. Empty: nothing runs
FORCE_DELETE_SKIP=""                    # OPTIONAL: (label selector) pods the force-delete in 03e and remove-node spares, e.g. "cnpg.io/podRole notin (instance)". Empty: it kills every pod on the node
REBALANCE_SKIP_NAMESPACES=""            # OPTIONAL: (space-separated namespaces) 03g never restarts these, e.g. the CSI driver and the ingress data plane
REBALANCE_PVC_NAMESPACES=""             # OPTIONAL: (space-separated namespaces) 03g also restarts PVC-mounting Recreate Deployments here. Empty: a PVC always means skip
DISABLE_FLANNEL_AND_KUBE_PROXY="false"  # OPTIONAL: true | false. true leaves the CNI to you, false keeps Talos' Flannel. Fixed at bootstrap
GHCR_USER="your-github-username"        # OPTIONAL: (string) the GitHub user the pull token below belongs to
GITHUB_GHCR_PULL_TOKEN_SECRET=""        # OPTIONAL: (classic PAT, read:packages) 03c bakes it into every node so the kubelet pulls private ghcr.io images. Empty: public images only
