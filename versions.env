# The committed version pins, sourced by lib/shell/common.sh before .env. Renovate bumps them.

## Capped by the pinned Talos release's Kubernetes default, so bump TALOS_IMAGE_RELEASE first
# renovate: datasource=github-releases depName=kubernetes/kubernetes
KUBERNETES_VERSION="1.37.1"

## The Pi 5 Talos image release, `<talos version>-<build revision>`. 03a flashes it, 03e upgrades to it
# renovate: datasource=github-releases depName=yama6a/talos-raspberry-pi5 versioning=regex:^v(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)-(?<build>\d+)$
TALOS_IMAGE_RELEASE="v1.14.1-1"
