{
  // Opens dependency-update PRs for every pin in the repo. Which manager owns what:
  //   github-actions  the renovate workflow's own action pins
  //   customManagers  images in the k8s manifests + shell scripts, and the versions.env pins
  // Cadence is the cron in .github/workflows/renovate.yaml, not an internal `schedule`, so a manual
  // workflow_dispatch works too. Docs: docs/06_renovate.md.
  //
  // The shared preset carries the grouping, automerge and digest-pinning rules. Only what is specific
  // to this repo lives below.
  // Nothing here applies itself: a merged bump only changes a pinned string. TALOS_IMAGE_RELEASE and
  // KUBERNETES_VERSION take effect when 03e/03f run, the nic-keeper image when 03d runs, and a fresh
  // drive needs 03a. To de-risk anyway, add minimumReleaseAge or drop automerge from the deps to gate.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>yama6a/gha:default.json5"],

  // Nothing here is packaged or templated: the one thing this repo applies is a plain manifest in lib/k8s/,
  // so every container image is annotated and picked up by the customManager below.
  customManagers: [
    {
      // Images annotated `# renovate: datasource=docker`: the k8s manifests, shell-script literals, and the
      // versions.env extensions.
      // Captures repo:tag(+digest) from the ref itself, so tag AND digest stay fresh.
      customType: "regex",
      description: "docker image refs (annotated) in k8s manifests, shell scripts and versions.env",
      managerFilePatterns: [
        "/^versions\\.env$/",
        "/^lib/shell/.*\\.sh$/",
        "/^lib/k8s/.*\\.yaml$/",
      ],
      matchStrings: [
        "# renovate: datasource=docker(?: versioning=(?<versioning>\\S+))?\\s+[^\\n]*?(?<depName>[a-z0-9][a-z0-9._/-]+):(?<currentValue>[\\w][\\w.-]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?",
      ],
      datasourceTemplate: "docker",
    },
    {
      // Scalar vars in versions.env carrying a full `# renovate:` annotation. TALOS_IMAGE_RELEASE's
      // annotation also carries a `versioning=regex:...`, because its `-<build revision>` suffix would
      // otherwise read as a semver prerelease and be skipped as unstable.
      customType: "regex",
      description: "annotated version scalars in versions.env",
      managerFilePatterns: ["/^versions\\.env$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+\\w+=\"(?<currentValue>[^\"]+)\"",
      ],
    },
  ],

  packageRules: [
    {
      // k8s release tags are v-prefixed and the versions.env value is not, so strip the v when comparing.
      description: "kubernetes tags are v-prefixed",
      matchPackageNames: ["kubernetes/kubernetes"],
      extractVersion: "^v(?<version>.+)$",
    },
  ],
}
