# Per-deployment config and secrets. Only bare `.env` is ignored, so .env.example and versions.env stay tracked.
.env
.env.bak
.env.bak.*

# Your node list, with real hostnames and IPs.
inventory.yaml

# Cluster credentials written by 03c. A symlink to an off-repo store. Never commit it or what it points at.
/secrets

# 03a's image downloads and other scratch.
/.cache/

# Editor and OS files. Listed here, so a fork on another machine does not commit them.
.idea/
.vscode/
.DS_Store
__pycache__/
